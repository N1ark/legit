{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legit",
  "version": "0.1.0",
  "identifier": "com.n1ark.legit",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build && npm run build:sidecar"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/legit-server"
    ],
    "resources": {
      "../dist/": "dist/"
    },
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
