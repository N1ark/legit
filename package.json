{
  "name": "legit",
  "version": "0.1.0",
  "description": "A tiny, fast UI to edit, split, squash and reorder git commits.",
  "type": "module",
  "private": true,
  "bin": {
    "legit": "bin/legit.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node bin/legit.ts --dev",
    "build": "vite build",
    "prepare": "vite build",
    "check": "svelte-check --tsconfig src/ui/tsconfig.json && tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "app:dev": "npm run build:sidecar && tauri dev",
    "app:build": "tauri build",
    "app:install": "tauri build && rm -rf /Applications/Legit.app && cp -R src-tauri/target/release/bundle/macos/Legit.app /Applications/"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@types/prismjs": "^1.26.6",
    "prismjs": "^1.30.0",
    "purr": "file:../purr",
    "rolldown": "^1.2.11",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.0",
    "vite": "^8.3.1"
  }
}
