{
  "name": "legit",
  "version": "0.1.0",
  "description": "A tiny, fast UI to edit, split, squash and reorder git commits.",
  "type": "module",
  "private": true,
  "bin": {
    "legit": "bin/legit.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node bin/legit.ts --dev",
    "build": "vite build",
    "prepare": "vite build",
    "check": "svelte-check --tsconfig src/ui/tsconfig.json && tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "@types/prismjs": "^1.26.6",
    "phosphor-svelte": "^3.1.0",
    "prismjs": "^1.30.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.0",
    "vite": "^8.3.1"
  }
}
